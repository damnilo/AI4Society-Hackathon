# Copy to .env — never commit secrets.
# XAI_API_KEY: map from api_keys.txt SPACEX_API_KEY (xai-...)
# OPENAI_API_KEY: Vision (Faza 3) + TTS vodiča

DATABASE_URL=sqlite:///./putokaz.db
# Docker Compose Postgres:
# DATABASE_URL=postgresql+psycopg://putokaz:putokaz@localhost:5432/putokaz

XAI_API_KEY=
OPENAI_API_KEY=
XAI_MODEL=grok-3
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
JWT_SECRET=change-me-phase-1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=./uploads
MASTER_KEY=dev-only-not-for-prod
DOCUMENT_RETENTION_HOURS=48
