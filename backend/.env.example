# Copy to .env — never commit secrets.
# XAI_API_KEY: map from api_keys.txt SPACEX_API_KEY (xai-...)
# OPENAI_API_KEY: Vision (Faza 3) + TTS vodiča
#
# Generate secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

DATABASE_URL=sqlite:///./nasalter.db
# Optional Postgres (persistencija posle restarta, npr. Render disk/compose):
# DATABASE_URL=postgresql+psycopg://nasalter:nasalter@localhost:5432/nasalter

XAI_API_KEY=
OPENAI_API_KEY=
XAI_MODEL=grok-3
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova

JWT_SECRET=
MASTER_KEY=

# Localhost je uvek dozvoljen. Dodaj Render FE URL ovde ili u FRONTEND_ORIGIN.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_ORIGIN=
# ENVIRONMENT=production

UPLOAD_DIR=./uploads
DOCUMENT_RETENTION_HOURS=48
